# Auto detect text files and normalize line endings
* text=auto

# Python
*.py text diff=python
*.pyx text diff=python

# Shell scripts
*.sh text eol=lf

# Markdown
*.md text diff=markdown

# JSON/YAML
*.json text
*.yml text
*.yaml text

# RPM spec
*.spec text

# Binary files
*.rpm binary
*.gz binary
*.tar binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
